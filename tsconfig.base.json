{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    // Keep the incremental build info inside the output directory, so removing
    // dist/ also removes it. Left at the default, a deleted dist/ plus a stale
    // tsbuildinfo makes `tsc --build` report success while emitting nothing.
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
