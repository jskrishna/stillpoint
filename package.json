{
  "name": "stillpoint",
  "version": "0.1.0",
  "private": true,
  "description": "Stillpoint \u2014 a voice guide through the six-step Choose Again process",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean && rm -rf coverage",
    "typecheck": "tsc -p tsconfig.test.json && pnpm --filter './apps/*' run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/run.mjs",
    "demo": "node e2e/run.mjs --demo",
    "check": "pnpm run build:packages && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "build:packages": "pnpm --filter './packages/*' run build",
    "parity:generate": "pnpm run build:packages && node parity/generate.mjs",
    "clinical:review": "pnpm run build:packages && node docs/clinical-review/generate.mjs && prettier --write docs/clinical-review/RISK-SCREEN-REVIEW.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
