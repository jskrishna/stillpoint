# Where the API is.
#
# `EXPO_PUBLIC_*` is inlined into the bundle at build time, which is right for a
# base URL and wrong for anything secret.
#
# The default (in src/api.ts) is localhost, which works for a simulator running
# on the same machine as `php artisan serve`. A real device cannot reach your
# laptop's localhost: set this to the machine's address on the network, and
# serve the API on all interfaces (`php artisan serve --host=0.0.0.0`).
EXPO_PUBLIC_API_URL=http://localhost:8000/api
