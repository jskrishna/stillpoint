{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,

    // CSS Modules type as { readonly [key: string]: string }, so every
    // styles.foo would have to be written styles['foo']. The rule earns its
    // keep on data objects, which live in the packages, not on stylesheets.
    "noPropertyAccessFromIndexSignature": false,

    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Workspace packages resolve through node_modules to their built output,
    // exactly as an outside consumer would, so the build verifies the real
    // emitted .d.ts. `pnpm run build:packages` must therefore run before lint
    // and typecheck; `pnpm run check` does that first.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
