# Copy to `.env` at the repository root, beside docker-compose.yml.

# Generate with:  echo "base64:$(openssl rand -base64 32)"
#
# Not with `docker compose run ... artisan key:generate`, which this file used
# to say. Compose refuses to start anything, that command included, while
# APP_KEY is empty: it is the key it is waiting for.
#
# Read this before you set it: every journal entry, every session and every
# safety flag is encrypted with this key. Change it or lose it and that content
# is gone — not locked, gone. It belongs in whatever holds your other secrets,
# with a copy somewhere a single lost laptop does not take with it.
APP_KEY=

# Where each half is reachable from a browser.
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# Baked into the web image at build time, because the browser is what calls it.
PUBLIC_API_URL=http://localhost:8000/api

# Comma-separated, never '*': this API carries personal health content behind
# bearer tokens.
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_DATABASE=stillpoint
DB_USERNAME=stillpoint
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Ports on the host.
WEB_PORT=3000
API_PORT=8000

# `log` writes password-reset links to the container's log instead of sending
# them. There is no mail driver chosen yet; see deploy/README.md.
MAIL_MAILER=log
# For `smtp`, which needs nothing installed. The address has to be on a domain
# you may send for; `php artisan stillpoint:preflight` reports the default.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Stillpoint

# Only while rotating APP_KEY: the key being replaced goes here, the new one
# above, then `php artisan stillpoint:rotate-key`. See deploy/README.md.
APP_PREVIOUS_KEYS=

# The proxy in front of this stack, once there is one holding the certificate.
# A comma-separated list, or `*`. Empty trusts nothing. See deploy/README.md.
TRUSTED_PROXIES=
